{
  "name": "echo-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check:vehicle-crashes": "node scripts/check-vehicle-crash-model.mjs",
    "check:buildings": "node scripts/check-building-stair-physics.mjs && node scripts/check-building-layouts.mjs && node scripts/check-building-traversal.mjs",
    "check:space-parachute": "node scripts/check-space-parachute-input.mjs",
    "test": "npm run check:input-wrappers && npm run check:physical-input && npm run check:space-parachute",
    "check:input-wrappers": "node scripts/check-input-wrapper-impulses.mjs",
    "check:physical-input": "node --test scripts/check-physical-input-client-pipeline.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d": "0.19.3",
    "@dimforge/rapier3d-compat": "0.19.3",
    "xstate": "5.32.5"
  },
  "devDependencies": {
    "wrangler": "^4.120.1"
  }
}
